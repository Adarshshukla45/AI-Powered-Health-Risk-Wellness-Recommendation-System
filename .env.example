# =========================================================
# ai-health-risk-system — environment variable template
# Copy this file to .env in EACH service that needs it
# (backend/.env and ml-service/.env). Never commit the
# real .env files.
# =========================================================

# ---------- backend/.env ----------
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/ai_health_risk_system

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# URL of the Python FastAPI ML service
ML_SERVICE_URL=http://localhost:8000

# Frontend origin, for CORS
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- ml-service/.env ----------
ML_SERVICE_PORT=8000
MODEL_DIR=./models
LOG_LEVEL=info

# ---------- frontend/.env ----------
VITE_API_BASE_URL=http://localhost:5000/api
